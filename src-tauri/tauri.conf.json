{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hydrogen Music",
  "version": "0.8.0",
  "identifier": "music.hydrogen.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hydrogen Music",
        "width": 1024,
        "height": 672,
        "minWidth": 1024,
        "minHeight": 672,
        "decorations": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "../src/assets/icon/icon.ico"]
  }
}
